{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repair-cafe-telemetry",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-15",
  // nodejs_compat: node:crypto for tokens and the admin check.
  // global_fetch_strictly_public: every fetch, verification included, leaves
  // over the public internet, even to our own zones. A hub on a workers.dev
  // address in this account can then be verified, rather than failing with
  // error 1042.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Copies the page and MapLibre into dist/assets and stamps the version.
  "build": { "command": "node scripts/build-assets.mjs" },

  // The page and its files never run the Worker. Only the API and the health
  // check do, and anything that is not a file falls through to it for a 404.
  "assets": {
    "directory": "dist/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },

  "workers_dev": true,
  "preview_urls": false,
  // repaircafetelemetry.bzwrd.co.uk is attached as a custom domain at cutover.
  // See docs/plan-cloudflare-worker.md.

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "repair-cafe-telemetry",
      "database_id": "15cd41bc-ef8d-42a1-9466-04098776a679",
      "migrations_dir": "migrations"
    }
  ],

  // Hourly limits per address. See src/limiter.ts.
  "durable_objects": {
    "bindings": [{ "name": "LIMITER", "class_name": "Limiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Limiter"] }],

  // Per-minute limits. The binding only counts in 10 or 60 second windows.
  "ratelimits": [
    { "name": "BACKSTOP_LIMIT", "namespace_id": "5040", "simple": { "limit": 120, "period": 60 } },
    { "name": "ADMIN_LIMIT", "namespace_id": "5041", "simple": { "limit": 30, "period": 60 } },
    { "name": "VERIFY_LIMIT", "namespace_id": "5042", "simple": { "limit": 30, "period": 60 } }
  ],

  // Refresh the repaircafe.org directory once a day, early in the morning.
  "triggers": { "crons": ["17 4 * * *"] },

  "vars": {
    "MAX_CLOCK_SKEW_HOURS": "48",
    "MAX_BODY_KB": "64"
  },
  // Secrets, set with `wrangler secret put`: ADMIN_TOKEN, LIMIT_SECRET.

  "observability": { "enabled": true }
}
