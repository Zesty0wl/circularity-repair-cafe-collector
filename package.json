{
  "name": "repair-cafe-telemetry",
  "version": "2.0.4",
  "private": true,
  "type": "module",
  "description": "Collects anonymous usage counts from Circularity Repair Cafe Hub installs. Runs as a Cloudflare Worker.",
  "license": "MIT",
  "scripts": {
    "build:assets": "node scripts/build-assets.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "wrangler dev",
    "pretest": "node scripts/build-assets.mjs",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply repair-cafe-telemetry --remote"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "maplibre-gl": "^6.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261014.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.0"
  },
  "engines": {
    "node": ">=22"
  }
}
