# Copy to .env and fill in. Both secrets should be long and random:
#   openssl rand -hex 24

# Password for the bundled Postgres container.
DB_PASSWORD=please-change-me

# Shared secret for /api/v1/admin/*, sent as "Authorization: Bearer <token>".
# At least 24 characters. Without it the app refuses to start.
ADMIN_TOKEN=please-change-me-at-least-24-chars

# Optional
TZ=Europe/London
LOG_LEVEL=info
